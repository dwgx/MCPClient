<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.marcloud.mcp.189</groupId>
        <artifactId>mcpclient-parent</artifactId>
        <version>1.8.9</version>
    </parent>

    <artifactId>dwm-skiko</artifactId>
    <packaging>jar</packaging>
    <description>
        DWM Skiko backend — a PURE-JAVA RenderBackend that maps DWM's DrawContext
        primitives onto Skia's Canvas via Skiko (org.jetbrains.skia.*), for the
        highest-fidelity Material 3 rendering: true antialiased rounded rects,
        gradients, elevation shadows, and real font text. NO Kotlin source, NO
        Compose, NO @Composable — Skiko's org.jetbrains.skia.* is the JetBrains
        fork of Skija (a Java-native API); the only interop wrinkle is that
        factories live on Kotlin Companion objects (X.Companion.foo() from Java).
        See .ai-notes/design-briefs/skiko-backend-notes.md.

        Sibling of dwm-gl / dwm-imgui: same DrawContext axis, same
        detachable-auxiliary contract (delete it, the reactor stays green; core
        discovers it reflectively). Skia/Skiko types live ONLY in this adapter
        island. It REUSES dwm-gl's GlStateGuard verbatim (compile dep on dwm-gl):
        Skia's raw GL calls disturb the same state MC's GlStateManager shadows, so
        the same full shadow write-through — bracketed with DirectContext.resetGLAll()
        and a stencil-8 FBO — is what keeps MC rendering after the overlay. Layering:
        dwm-skiko -> dwm-gl -> dwm.
    </description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <skiko.version>0.144.6</skiko.version>
    </properties>

    <dependencies>
        <!-- Sibling GL backend: reuse GlStateGuard (the shadow write-through) +
             GameBackendHost verbatim. compile so both are bundled into this fat jar.
             Layering dwm-skiko -> dwm-gl -> dwm keeps ONE copy of the fix. -->
        <dependency>
            <groupId>net.marcloud.mcp.189</groupId>
            <artifactId>dwm-gl</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- The DWM SPI (RenderBackend, DrawContext, BackendHost, UiComposer, ...).
             compile: bundled into the fat jar (dwm is not on the live game classpath). -->
        <dependency>
            <groupId>net.marcloud.mcp.189</groupId>
            <artifactId>dwm</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Skiko: skiko-awt is the org.jetbrains.skia.* API (Java-callable);
             skiko-awt-runtime-windows-x64 carries skiko-windows-x64.dll + icudtl.dat
             as classpath resources (extracted at runtime by Library.INSTANCE.load()).
             Both bundled into the fat jar. On Maven Central (no Google-maven needed —
             that was only for Compose's androidx transitives, which this module drops). -->
        <dependency>
            <groupId>org.jetbrains.skiko</groupId>
            <artifactId>skiko-awt</artifactId>
            <version>${skiko.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.skiko</groupId>
            <artifactId>skiko-awt-runtime-windows-x64</artifactId>
            <version>${skiko.version}</version>
        </dependency>

        <!-- The game: GLFW window handle + GlStateManager (reflective at runtime).
             provided: client jar is already on the live -cp. -->
        <dependency>
            <groupId>net.marcloud.mcp.189</groupId>
            <artifactId>client</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- LWJGL3 GLFW + OpenGL API jars, pinned to the parent's 3.3.6 (game supplies
             them at runtime). provided so the fat jar does not bundle a second GL loader. -->
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-opengl</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Fat jar (dwm-skiko-*-all.jar): bundles dwm SPI + dwm-gl (GlStateGuard +
                 GameBackendHost) + skiko API classes + skiko-windows-x64.dll + icudtl.dat
                 (UNRELOCATED so Library.load's classpath extraction finds them). provided
                 deps (client / lwjgl) excluded automatically. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>all</shadedClassifierName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
