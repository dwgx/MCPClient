<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.marcloud.mcp.189</groupId>
        <artifactId>mcpclient-parent</artifactId>
        <version>1.8.9</version>
    </parent>

    <artifactId>dwm-gl</artifactId>
    <packaging>jar</packaging>
    <description>
        DWM GL backend — a PURE-JAVA ContentBackend adapter that renders an in-game
        overlay with handwritten immediate-mode OpenGL (glBegin/glVertex, MC 1.8.9's
        own fixed-function profile). No Kotlin, no Compose, no Skiko, no native DLL:
        the "not one line of Kotlin" sibling of dwm-compose, hanging off the SAME
        DWM ContentBackend SPI. Discovered reflectively by core; delete this module
        and the whole build stays green (detachable auxiliary).

        The root-cause fix for the black-screen overlay lives here in GlStateGuard:
        a FULL write-through of Minecraft's GlStateManager Java-side shadow cache
        (blend / depth / texture-binding / active-unit) plus a raw-GL restore of the
        states MC does not shadow (program / FBO / viewport). GL/reflection types
        live ONLY in this adapter island, never above the SPI.
    </description>

    <properties>
        <!-- Modern aux layer, like dwm/core: JBR25 runtime bytecode, not Java-8
             game bytecode. Overrides the parent's release=8. -->
        <maven.compiler.release>25</maven.compiler.release>
    </properties>

    <dependencies>
        <!-- The DWM SPI this module's GlContentBackend implements (ContentBackend,
             BackendHost, ComposeCompositor, ...). compile scope: dwm is NOT on the
             live game classpath (only game + core-all + this fat jar are), so its
             SPI classes MUST be bundled INTO this fat jar — otherwise the reflective
             entry point fails with NoClassDefFoundError: BackendHost at runtime
             (the exact failure dwm-compose hit and fixed the same way). -->
        <dependency>
            <groupId>net.marcloud.mcp.189</groupId>
            <artifactId>dwm</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- The game: GLFW window handle + GlStateManager (reached reflectively at
             runtime). provided: client jar is already on the live -cp. -->
        <dependency>
            <groupId>net.marcloud.mcp.189</groupId>
            <artifactId>client</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- LWJGL3 GLFW + OpenGL API jars (from parent lwjgl-bom 3.3.6). PROVIDED:
             GlStateGuard/compositor GL calls compile against these, and at runtime
             LWJGL is supplied by the game (client jar) — so NOT bundled into the
             fat jar. The natives-windows classifiers are test-scope: only a
             standalone offscreen harness would create its own GLFW context; the
             live overlay uses the game's context. -->
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-opengl</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Fat jar (dwm-gl-*-all.jar): bundles the dwm SPI so the game JVM can
                 load this backend by adding ONE jar to -cp. provided deps
                 (client / lwjgl — already on the live classpath) are excluded
                 automatically. core stays backend-free and discovers this
                 reflectively; deleting this module leaves the reactor green. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>all</shadedClassifierName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
