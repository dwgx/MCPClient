<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.marcloud.mcp.189</groupId>
        <artifactId>mcpclient-parent</artifactId>
        <version>1.8.9</version>
    </parent>

    <artifactId>dwm-imgui</artifactId>
    <packaging>jar</packaging>
    <description>
        DWM imgui backend — a ContentBackend adapter that renders an in-game
        overlay with Dear ImGui via SpaiR imgui-java (JNI to native C++ Dear
        ImGui). Sibling of dwm-gl: same DWM ContentBackend SPI, same
        detachable-auxiliary contract (delete it and the reactor stays green;
        core discovers it reflectively). imgui / Dear-ImGui types live ONLY in
        this adapter island (package net.marcloud.mcp.dwm.backend.imgui).

        It REUSES dwm-gl's GlStateGuard and GameBackendHost verbatim (a compile
        dependency on dwm-gl) rather than duplicating the black-screen root-cause
        fix: imgui's own renderDrawData restores raw GL to entry values but
        structurally CANNOT touch Minecraft's GlStateManager Java-side shadow
        cache, so the same shadow write-through GlStateGuard performs is what
        keeps MC rendering correctly the frame after the overlay. Layering:
        dwm-imgui -> dwm-gl -> dwm.

        Native delivery (per .ai-notes/design-briefs/imgui-native-lib-notes.md):
        the prebuilt io.github.spair:imgui-java-natives-windows jar carries
        imgui-java64.dll as a classpath resource; it is bundled UNRELOCATED into
        this module's fat jar. LWJGL is pinned to the parent's 3.3.6 (the game
        supplies it at runtime) so imgui-java-lwjgl3's transitive 3.4.1 BOM
        cannot ABI-split the GL bindings.
    </description>

    <properties>
        <!-- Modern aux layer, like dwm-gl/core: JBR25 runtime bytecode, not
             Java-8 game bytecode. Overrides the parent's release=8. -->
        <maven.compiler.release>25</maven.compiler.release>
        <imgui.version>1.92.0</imgui.version>
    </properties>

    <dependencies>
        <!-- Sibling GL backend: reuse GlStateGuard (the black-screen fix) and
             GameBackendHost verbatim. compile scope so both are bundled into this
             fat jar. Layering dwm-imgui -> dwm-gl -> dwm keeps ONE copy of the
             load-bearing shadow write-through. -->
        <dependency>
            <groupId>net.marcloud.mcp.189</groupId>
            <artifactId>dwm-gl</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- The DWM SPI (ContentBackend, BackendHost, ComposeCompositor, ...).
             compile scope: bundled into the fat jar (dwm is not on the live game
             classpath). dwm-gl already pulls it, but declare it explicitly so this
             module's compile does not depend on dwm-gl's transitive graph. -->
        <dependency>
            <groupId>net.marcloud.mcp.189</groupId>
            <artifactId>dwm</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- imgui-java: binding (Java API) + lwjgl3 (GL3 renderer) compile; the
             natives jar (carries imgui-java64.dll as a classpath resource) runtime.
             All bundled into the fat jar. imgui types live only in this module. -->
        <dependency>
            <groupId>io.github.spair</groupId>
            <artifactId>imgui-java-binding</artifactId>
            <version>${imgui.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.spair</groupId>
            <artifactId>imgui-java-lwjgl3</artifactId>
            <version>${imgui.version}</version>
            <exclusions>
                <!-- lwjgl-sdl is new in the 1.92 line and unused by the GL3 path;
                     excluding it avoids dragging an extra lwjgl artifact. -->
                <exclusion>
                    <groupId>org.lwjgl</groupId>
                    <artifactId>lwjgl-sdl</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.github.spair</groupId>
            <artifactId>imgui-java-natives-windows</artifactId>
            <version>${imgui.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- The game: GLFW window handle + GlStateManager (reached reflectively at
             runtime). provided: client jar is already on the live -cp. -->
        <dependency>
            <groupId>net.marcloud.mcp.189</groupId>
            <artifactId>client</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- LWJGL3 GLFW + OpenGL API jars, pinned to the parent's 3.3.6 (the game
             supplies them at runtime). PROVIDED so the fat jar does not bundle a
             second GL loader, AND so the parent's dependencyManagement 3.3.6 pin
             wins over imgui-java-lwjgl3's transitively-imported lwjgl-bom:3.4.1. -->
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-opengl</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Fat jar (dwm-imgui-*-all.jar): bundles dwm SPI + dwm-gl (GlStateGuard
                 + GameBackendHost) + imgui-java classes + imgui-java64.dll
                 (io/imgui/java/native-bin/**, UNRELOCATED so the loader's classpath
                 extraction still finds it). provided deps (client / lwjgl — already
                 on the live classpath) are excluded automatically. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>all</shadedClassifierName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
