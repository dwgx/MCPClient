<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.marcloud.mcp.189</groupId>
        <artifactId>mcpclient-parent</artifactId>
        <version>1.8.9</version>
    </parent>

    <artifactId>core</artifactId>
    <packaging>jar</packaging>
    <description>
        MCP Core — exposes the running Minecraft client to an AI over the Model
        Context Protocol. Provides live observation (state, packets, disconnects),
        control (chat, movement, arbitrary packets), and hot-load (compile/redefine
        code into the running game via JavaCompiler + Instrumentation/DCEVM).
        Net-new code, compiled to Java 25 bytecode. Does NOT modify the frozen MC
        source; all MC seams are attached at runtime via bytecode instrumentation.
    </description>

    <properties>
        <!-- Override the parent's release=8: this module targets Java 25 so it can
             use the MCP SDK (needs Java 17+) and modern language features. It runs
             in the SAME JVM as the Java-8 game bytecode (JDK 25 runs both fine). -->
        <maven.compiler.release>25</maven.compiler.release>
        <bytebuddy.version>1.17.6</bytebuddy.version>
        <mcp.sdk.version>2.0.0</mcp.sdk.version>
        <!-- Plain (un-shaded) ASM for the compat bytecode transforms. ByteBuddy
             bundles ASM 9.8 but under its shaded net.bytebuddy.jar.asm package, which
             is not usable as org.objectweb.asm; pin the same 9.8 pg-engine already
             uses so both modules parse/emit with one ASM version. BSD-3. -->
        <asm.version>9.8</asm.version>
    </properties>

    <dependencies>
        <!-- The game itself: lets Core reference Minecraft, NetworkManager, Packet,
             etc. The client already brings LWJGL3/Netty/guava transitively.
             'provided' so Core does not re-bundle the game — it is loaded by the
             same classloader at runtime. -->
        <dependency>
            <groupId>net.marcloud.mcp.189</groupId>
            <artifactId>client</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Byte Buddy: runtime bytecode generation + agent attach helper.
             1.17.6 supports JDK 25 (ASM 9.8). Apache-2.0. -->
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy</artifactId>
            <version>${bytebuddy.version}</version>
        </dependency>
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy-agent</artifactId>
            <version>${bytebuddy.version}</version>
        </dependency>

        <!-- Official Java MCP SDK (io.modelcontextprotocol.sdk). MIT. Requires
             Java 17+ (hence this module's release=25). Brings Jackson + Reactor;
             zero Netty (no clash with the client's netty-all 4.2.16). -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp</artifactId>
            <version>${mcp.sdk.version}</version>
        </dependency>

        <!-- ASM: parse + rewrite vanilla class bytes in compat patches (KI-4, ...).
             Un-shaded org.objectweb.asm, same 9.8 as pg-engine. -->
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
            <version>${asm.version}</version>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-tree</artifactId>
            <version>${asm.version}</version>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>

        <!-- PHASE E: board on the TEST classpath ONLY. core's MAIN code has zero
             compile dependency on board (it reaches board purely by reflection via
             BoardTraceLink/BoardWorldEventBridge). But the PHASE-E link tests must
             exercise the real reflective round-trip against genuine board Signal
             classes (publish a real ChatSendSignal, read its veto flag; map events
             to real DisconnectSignal/ChatReceiveSignal/BlockChangeSignal). 'test'
             scope keeps board off main compile and off the runtime/agent jar, so
             the zero-hard-dependency peer contract is preserved — board is present
             for the tests the same way it is present at runtime in a full client. -->
        <dependency>
            <groupId>net.marcloud.mcp.189</groupId>
            <artifactId>board</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Plain core jar carries the agent manifest so it can be used as
                 -javaagent directly (when its deps are also on -cp). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Premain-Class>net.marcloud.mcp.core.boot.CoreAgent</Premain-Class>
                            <Agent-Class>net.marcloud.mcp.core.boot.CoreAgent</Agent-Class>
                            <Can-Redefine-Classes>true</Can-Redefine-Classes>
                            <Can-Retransform-Classes>true</Can-Retransform-Classes>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <!-- Fat agent jar: bundles Core + Byte Buddy (Apache-2.0) + MCP SDK
                 (MIT) + Jackson/Reactor so -javaagent:core-all.jar is fully
                 self-sufficient (no -cp ordering dependence). The game (client)
                 is 'provided' and NOT bundled. No GPL: DCEVM is a JBR built-in
                 (not HotSwapAgent), so nothing copyleft enters this jar. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>all</shadedClassifierName>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <manifestEntries>
                                        <Premain-Class>net.marcloud.mcp.core.boot.CoreAgent</Premain-Class>
                                        <Agent-Class>net.marcloud.mcp.core.boot.CoreAgent</Agent-Class>
                                        <Can-Redefine-Classes>true</Can-Redefine-Classes>
                                        <Can-Retransform-Classes>true</Can-Retransform-Classes>
                                        <Multi-Release>true</Multi-Release>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
