<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.marcloud.mcp.189</groupId>
        <artifactId>mcpclient-parent</artifactId>
        <version>1.8.9</version>
    </parent>

    <artifactId>dwm</artifactId>
    <packaging>jar</packaging>

    <properties>
        <!-- Java 8: dwm subclasses GuiScreen, so it shares the client's bytecode level. -->
        <maven.compiler.release>8</maven.compiler.release>

        <!-- qml4j is consumed as a PUBLISHED Maven Central artifact, never vendored.
             Following a new upstream release is this one line. Changes needed inside
             qml4j itself go through the dwgx/qml4j topic stack and up to TIMER-err;
             forking it here would end our ability to track upstream.
             0.2.27 (Central 2026-08-17): independent per-corner radii (dwgx #15),
             ancestor Flickable wheel fall-through, focus-property routing, and the
             0.2.25/0.2.26 clipboard+password hardening. Skija pin unchanged. -->
        <qml4j.version>0.2.27</qml4j.version>
        <!-- Must match what qml4j 0.2.27 compiled against. -->
        <skija.version>0.143.16</skija.version>

        <!-- Live GL IT is opt-in; see the failsafe config below. -->
        <dwm.live.skip>true</dwm.live.skip>
        <!-- Overridden to -XstartOnFirstThread by the macos-live-gl profile. -->
        <dwm.live.argLine></dwm.live.argLine>
    </properties>

    <description>
        DWM — the in-game UI subsystem, codenamed after Windows' Desktop Window Manager
        (the NT/hardware metaphor: core=NT kernel, board=PCB, compat=AppCompat).

        Implemented on qml4j (QML scene graph rendered by Skija/Skia). Per the module
        contract it stays a detachable AUXILIARY layer: zero security power, imports no
        core class, discovered by Board through the reflective Backplane, and the UI is a
        real GuiScreen so MC's own screen lifecycle owns render/input/resize/focus.

        Every native and qml4j type is confined to the single adapter package
        net.marcloud.mcp.dwm.qml; the rest of the module talks to the ui.* SPI. See
        dwm/README.md for the design intent and docs/macos/dwm-qml4j-plan.md for the
        rollout.
    </description>

    <dependencies>
        <!-- The QML engine + scene graph. Window-agnostic: it creates no window and calls
             no GLFW, which is what lets us drive it from inside MC's own GL context. -->
        <dependency>
            <groupId>io.github.timer-err</groupId>
            <artifactId>qml4j-core</artifactId>
            <version>${qml4j.version}</version>
        </dependency>

        <!-- Skia bindings. qml4j declares skija-shared as provided, so the host picks it
             up explicitly along with the platform natives below. -->
        <dependency>
            <groupId>io.github.humbleui</groupId>
            <artifactId>skija-shared</artifactId>
            <version>${skija.version}</version>
        </dependency>

        <!-- Skia natives for every platform this module has to run on, in the same jar, the way
             client ships LWJGL's: the loader picks by os.name/os.arch at runtime, so one artifact
             runs on Windows x64, macOS arm64 and Linux x64. Deliberately NOT os-activated
             profiles, which would make the output depend on which machine built it. Linux is here
             because ubuntu-latest is where dwm's unit tests run and the loader has no fallback: it
             fails the run with UnsatisfiedLinkError ("Library file libskija.so not found") rather
             than skipping, which is what took the CI build down. -->
        <dependency>
            <groupId>io.github.humbleui</groupId>
            <artifactId>skija-windows-x64</artifactId>
            <version>${skija.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.github.humbleui</groupId>
            <artifactId>skija-macos-arm64</artifactId>
            <version>${skija.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.github.humbleui</groupId>
            <artifactId>skija-linux-x64</artifactId>
            <version>${skija.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- The game. provided: dwm renders inside the running client and is never
             shaded with a copy of it (the arrangement board uses). -->
        <dependency>
            <groupId>net.marcloud.mcp.189</groupId>
            <artifactId>client</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- board, TEST scope only. LiveStateTest drives the real Backplane rather than a
             stand-in, because the registry is the actual thing dwm reflects into at runtime and a
             fake one would prove only that the fake works. Test scope keeps this out of the module's
             compile and runtime graph, so the contract holds: dwm still links against no peer, and
             the seam it uses at runtime is still purely reflective. -->
        <dependency>
            <groupId>net.marcloud.mcp.189</groupId>
            <artifactId>board</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- The live GL integration tests (the 14 `*IT` classes) need a display and native
                 Skia, so they run under failsafe and are skipped by default.

                 To run them:  ./mvnw.cmd -pl dwm verify -Ddwm.live.skip=false

                 The property is `dwm.live.skip`, NOT `dwm.live`. It was `dwm.live` in an earlier
                 version of this comment, and that name is read by nothing in this repository, so
                 the documented command set an unknown property, left skipITs at its default
                 `true`, and answered a live request with "Tests are skipped." and BUILD SUCCESS
                 with all 14 classes unrun. Measured 2026-10-04; see docs/agency/test-census.md
                 section 3. A comment that names a property the pom does not read is a false green
                 of the same shape as a test that skips, and it costs the same to find.

                 They self-skip via Assume when there is no display, so enabling them on a
                 headless runner is safe: 45 tests, 0 skipped, 0 failed on Windows with a display;
                 14 classes of Assume skip with none. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <skipITs>${dwm.live.skip}</skipITs>
                    <!-- macOS: GLFW must own the main thread, and AWT must not start AppKit
                         beside it (see docs/macos/known-issues.md MK-1). Harmless elsewhere:
                         -XstartOnFirstThread is only added by the profile below. -->
                    <argLine>-Djava.awt.headless=true ${dwm.live.argLine}</argLine>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>macos-live-gl</id>
            <activation>
                <os>
                    <family>mac</family>
                </os>
            </activation>
            <properties>
                <dwm.live.argLine>-XstartOnFirstThread</dwm.live.argLine>
            </properties>
        </profile>
    </profiles>
</project>
