# --- Build output ---
target/
build/
*.class
.mvn/maven-dist/
.mvn/wrapper/maven-wrapper.jar

# Release asset bundles (uploaded to GitHub releases, not committed)
mc-assets-*.zip

# --- Runtime working dir (game assets ~2.7GB, saves, logs, natives) ---
test_run/
test_natives/

# --- Reference clones / scratch (proprietary + copyleft; never commit) ---
_analyze_base/
_refs/
_shim_raw/
_server_test/
# --- Vendored toolchains (JBR 25 w/ DCEVM ~278MB; never commit) ---
_tools/

# --- IDE / OS ---
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# Stray run/log dirs from in-module test launches
logs/
*/logs/
*/run/

# Compiled C6 JVMTI agent (rebuild via core/src/main/native/core-jvmti/build-clang.sh).
# One entry per host: the same C source builds a .dll / .dylib / .so, and the script
# drops a copy beside itself as well as under the ignored build/ directory.
core-jvmti.dll
core-jvmti.dylib
core-jvmti.so

# --- AI working notes (handoffs, per-area design notes, known-issues, agent
#     instructions like CLAUDE.md/CONTRIBUTING/SECURITY). AI-only scratch;
#     never committed. See .ai-notes/README.md for the index. ---
.ai-notes/

# Session handoffs and one-off telly/route harnesses -- never re-add.
docs/**/HANDOFF.md
docs/**/handoff-*.md
docs/**/session-*.md
docs/**/telly-test-plan.md
docs/**/mutation-candidates-*.json
scripts/live-telly-*.py
scripts/live-route-drive.py


# CodeGraph local code-knowledge-graph index (tree-sitter -> SQLite). Machine-
# local, rebuildable via `codegraph init`/`sync`; never committed.
.codegraph/

# Loose conversation / scratch dumps that land in the repo root during AI
# sessions (e.g. exported transcripts). Not products; keep `git status` clean so
# the session-status reconcile isn't noisy. Narrow patterns, NOT a blanket *.txt.
/conversation-*
/123.txt
# Live overlay smoke logs (run-mcp-overlay.bat > overlay.log): scratch, not products.
overlay.log
*/overlay.log
# capture-overlay.sh output (live PNGs + launch logs): scratch verification artifacts.
scripts/_capture/
scripts/_review/

# Compat signing private keys — NEVER commit
scripts/secrets/
*.key.b64
*-ed25519.priv

# JVM crash dumps (regenerable, never commit)
hs_err_pid*.log
replay_pid*.log

# Python bytecode cache — scripts/live-dwm-probe.py is imported by ad-hoc probes
__pycache__/
*.pyc

# Ephemeral git worktrees created for parallel agent runs; never committed.
.claude/worktrees/
