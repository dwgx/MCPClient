mc-assets-*.zip

# --- Runtime working dir (game assets ~2.7GB, saves, logs, natives) ---
test_run/
test_natives/

# --- Reference clones / scratch (proprietary + copyleft; never commit) ---
_analyze_base/
_refs/
_shim_raw/
_server_test/
# --- Vendored toolchains (JBR 25 w/ DCEVM ~278MB; never commit) ---
_tools/

# --- IDE / OS ---
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# Stray run/log dirs from in-module test launches
logs/
*/logs/
*/run/

# Compiled C6 JVMTI agent (rebuild via core/src/main/native/core-jvmti/build-clang.sh)
core-jvmti.dll

# --- AI working notes (handoffs, per-area design notes, known-issues, agent
#     instructions like CLAUDE.md/CONTRIBUTING/SECURITY). AI-only scratch;
#     never committed. See .ai-notes/README.md for the index. ---
.ai-notes/

# CodeGraph local code-knowledge-graph index (tree-sitter -> SQLite). Machine-
# local, rebuildable via `codegraph init`/`sync`; never committed.
.codegraph/

# Loose conversation / scratch dumps that land in the repo root during AI
# sessions (e.g. exported transcripts). Not products; keep `git status` clean so
# the session-status reconcile isn't noisy. Narrow patterns, NOT a blanket *.txt.
/conversation-*
/123.txt
